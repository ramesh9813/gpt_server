generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: premium/lite are legacy values kept only so `prisma db push` never has to
// drop a live Postgres enum value (which fails and would prevent startup).
// App logic treats exactly three roles: admin, owner, user.
enum UserRole {
  admin
  owner
  user
  premium
  lite
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         UserRole       @default(user)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?

  conversations Conversation[]
  folders      Folder[]
  refreshTokens RefreshToken[]
  settings     UserSettings?
  connectorTokens ConnectorToken[]
}

model UserSettings {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  theme                   String    @default("SYSTEM")
  accentColor             String    @default("#74aa9c")
  fontScale               String    @default("DEFAULT")
  brand                   String    @default("default")
  model                   String    @default("default")
  imageModel              String    @default("default")
  videoModel              String    @default("default")
  pinHeader               Boolean   @default(false)
  showTopCard             Boolean   @default(true)
  showScrollJump          Boolean   @default(true)
  showFollowups           Boolean   @default(true)
  appFontSize             Int       @default(18)
  iconScale               Float     @default(1)
  devicePhotosFolder      String?   @map("device_photos_folder")
  deviceScreenshotsFolder String?   @map("device_screenshots_folder")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  customPrompt        String?   @db.Text @map("custom_prompt")
  customPromptEnabled Boolean   @default(true) @map("custom_prompt_enabled")
  customPrompts       Json?     @map("custom_prompts")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  conversations Conversation[]

  @@index([userId])
}

model Conversation {
  id                  String    @id @default(cuid())
  userId              String
  folderId            String?
  title               String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?
  deletedAt           DateTime?
  pinned              Boolean   @default(false)
  quizAsked           Json?
  customPrompt        String?   @db.Text @map("custom_prompt")
  customPromptEnabled Boolean   @default(true) @map("custom_prompt_enabled")
  customPrompts       Json?     @map("custom_prompts")
  mutedFolderPromptIds Json?    @map("muted_folder_prompt_ids")

  user     User      @relation(fields: [userId], references: [id])
  folder   Folder?   @relation(fields: [folderId], references: [id])
  messages Message[]

  @@index([userId])
  @@index([folderId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  role           String
  content        String
  reasoning      String?
  images         Json?
  videos         Json?
  createdAt      DateTime      @default(now())
  tokenCount     Int?
  promptTokens   Int?
  completionTokens Int?
  model          String?
  status         String        @default("COMPLETE")
  error          String?
  followups      Json?
  quiz           Json?
  // Wall-clock time the assistant turn took (ms), set when the turn settles.
  durationMs     Int?
  // Web-search turns: flag + cited sources [{ title, url }] for the Sources UI.
  usedSearch     Boolean       @default(false)
  sources        Json?
  // File chat: metadata for user-attached files shown in the bubble.
  files          Json?

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Third-party connector OAuth tokens (e.g. Canva). Secrets are stored
// AES-256-GCM encrypted — never plaintext. One row per user+provider.
model ConnectorToken {
  id                 String    @id @default(cuid())
  userId             String
  provider           String
  accessTokenCipher  String
  refreshTokenCipher String?
  scope              String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// Single-use PKCE/state records for connector OAuth handshakes.
// The code_verifier lives here only for the few minutes of the flow,
// keyed by a hashed state value so the raw state never needs storage.
model ConnectorOAuthState {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  stateHash          String   @unique
  codeVerifier       String
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@index([userId])
}

// Admin-managed BYOK providers — custom OpenAI-compatible endpoints added
// at runtime (provider id + base URL + key rules). Merged with the static
// BYOK_PROVIDERS at serve time; isActive=false hides without deleting.
model Provider {
  id               String   @id
  name             String
  baseUrl          String
  kind             String   @default("openai")
  keyHint          String   @default("your API key")
  keyPattern       String?
  keylessModels    Boolean  @default(false)
  models           String[] @default([])
  streamUsage      Boolean  @default(false)
  allModelsFree    Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
