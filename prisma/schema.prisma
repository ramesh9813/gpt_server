generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: premium/lite are legacy values kept only so `prisma db push` never has to
// drop a live Postgres enum value (which fails and would prevent startup).
// App logic treats exactly three roles: admin, owner, user.
enum UserRole {
  admin
  owner
  user
  premium
  lite
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         UserRole       @default(user)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?

  conversations Conversation[]
  folders      Folder[]
  refreshTokens RefreshToken[]
  settings     UserSettings?
}

model UserSettings {
  id          String    @id @default(cuid())
  userId      String    @unique
  theme       String    @default("SYSTEM")
  accentColor String    @default("#74aa9c")
  fontScale   String    @default("DEFAULT")
  brand       String    @default("default")
  model       String    @default("default")
  imageModel  String    @default("default")
  videoModel  String    @default("default")
  pinHeader   Boolean   @default(false)
  appFontSize Int       @default(16)
  iconScale   Float     @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  conversations Conversation[]

  @@index([userId])
}

model Conversation {
  id         String    @id @default(cuid())
  userId     String
  folderId   String?
  title      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  deletedAt  DateTime?
  pinned     Boolean   @default(false)
  quizAsked  Json?

  user     User      @relation(fields: [userId], references: [id])
  folder   Folder?   @relation(fields: [folderId], references: [id])
  messages Message[]

  @@index([userId])
  @@index([folderId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  role           String
  content        String
  images         Json?
  videos         Json?
  createdAt      DateTime      @default(now())
  tokenCount     Int?
  promptTokens   Int?
  completionTokens Int?
  model          String?
  status         String        @default("COMPLETE")
  error          String?
  followups      Json?
  quiz           Json?

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
